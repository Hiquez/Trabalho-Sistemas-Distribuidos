FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends awscli jq && rm -rf /var/lib/apt/lists/*
COPY infrastructure/ministack/secret-entrypoint.sh /secret-entrypoint.sh
ENTRYPOINT ["sh", "/secret-entrypoint.sh"]
COPY coletasedestinacao/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY coletasedestinacao/ /app/
COPY contracts/events/v1 /app/contracts
ENV PYTHONUNBUFFERED=1
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/actuator/health',timeout=3)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
