{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "messageId",
    "correlationId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "ResultadoReserva"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "solicitacaoId",
        "reservada"
      ],
      "properties": {
        "solicitacaoId": {
          "type": "string",
          "format": "uuid"
        },
        "reservada": {
          "type": "boolean"
        },
        "reservaId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reservada": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "reservaId"
            ]
          }
        }
      ]
    }
  }
}
