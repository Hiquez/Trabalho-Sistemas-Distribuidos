{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "messageId",
    "correlationId",
    "type",
    "version",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "const": "SolicitarAceiteCooperativa"
    },
    "version": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "solicitacaoId",
        "reservaId",
        "categoriaResiduo",
        "quantidadeEstimada",
        "dataAgendada"
      ],
      "properties": {
        "solicitacaoId": {
          "type": "string",
          "format": "uuid"
        },
        "reservaId": {
          "type": "string",
          "format": "uuid"
        },
        "categoriaResiduo": {
          "type": "string"
        },
        "quantidadeEstimada": {
          "type": "number"
        },
        "dataAgendada": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}