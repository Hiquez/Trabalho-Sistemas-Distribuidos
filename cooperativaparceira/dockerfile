FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

COPY cooperativaparceira/pom.xml .
COPY cooperativaparceira/src ./src

RUN mvn clean package -DskipTests

FROM eclipse-temurin:21-jre

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends awscli jq && rm -rf /var/lib/apt/lists/*
COPY infrastructure/ministack/secret-entrypoint.sh /secret-entrypoint.sh

COPY --from=build /app/target/*.jar app.jar

EXPOSE 8083

ENTRYPOINT ["sh", "/secret-entrypoint.sh"]
CMD ["java", "-jar", "app.jar"]